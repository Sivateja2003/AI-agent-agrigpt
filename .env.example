# Copy this file to .env and fill in your values

# Groq API key (required)
# Used by /schemes and /pests endpoints; /chat accepts it per-request in the body
GROQ_API_KEY=gsk_your_groq_api_key_here

# LangChain / LangSmith tracing (optional — remove or leave blank to disable)
LANGCHAIN_API_KEY=lsv2_your_langsmith_api_key_here
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=agricultural-agent
